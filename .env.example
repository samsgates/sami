# Run deploy/scripts/init-env.sh to create local secrets instead of copying these placeholders.
SAMI_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
SAMI_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
SAMI_SIGNING_KEY=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
SAMI_BOOTSTRAP_KEY=REPLACE_WITH_RANDOM_CREDENTIAL_AT_LEAST_32_CHARACTERS
SAMI_ENV=production
SAMI_CONSOLE_PORT=8088
RUST_LOG=sami=info,tower_http=info
# For bare-metal development, export these separately:
# SAMI_DATABASE_URL=sqlite://sami.db?mode=rwc
# SAMI_DATA_DIR=./data
# SAMI_CONSOLE_DIR=./console/dist
# OIDC configuration must match the API's supported discovery/JWKS settings.
# Never use a client secret as a bearer token and never commit actual secrets.
# SAMI_OIDC_ISSUER=https://identity.example/issuer
# SAMI_OIDC_AUDIENCE=sami-service
# SAMI_OIDC_JWKS_URL=https://identity.example/issuer/jwks
# SAMI_CONNECTOR_HOSTS=ticket-api.example.com
# SAMI_DEVICE_ID=edge-device-001
# SAMI_WORKER_KEY=SCOPED_RECONCILIATION_CREDENTIAL
# Edge-only configuration; provision the device secret separately from the bundle.
# SAMI_BUNDLE_TRUST_KEYS=ISSUER_ED25519_PUBLIC_KEY_64_HEX
# SAMI_BUNDLE_ENCRYPTION_KEY=DEVICE_DECRYPTION_SECRET_64_HEX
