# syntax=docker/dockerfile:1.7
FROM node:22.23.0-bookworm-slim AS builder
WORKDIR /build
COPY console/package.json console/package-lock.json console/.npmrc ./
RUN npm ci --no-audit --no-fund
COPY console/ ./
RUN npm run build
FROM caddy:2.10.2-alpine
RUN mkdir -p /srv /config /data && chown -R 10001:10001 /srv /config /data
COPY --from=builder --chown=10001:10001 /build/dist /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile
USER 10001:10001
EXPOSE 8080
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
